# armdash reads this file at startup. Only what the process needs before it can
# serve a page belongs here: where to listen and HTTPS. Everything else, the
# login, Prometheus, the FRITZ!Box and navbar links, is set up on the settings
# page and saved in /var/lib/armdash/settings.json.
#
# Any other AD_ variable set here still works and wins over the page, which
# then shows that field locked. Delete the line to manage it on the page.

# Where plain HTTP is served. :9494 accepts connections from the LAN, :80 is
# the default HTTP port, which the unit grants the capability for.
AD_CORE_ADDR=:9494

# HTTPS turns on when both paths are set, one without the other refuses to
# start. The address above then redirects here, except /metrics, which
# Prometheus keeps scraping over plain HTTP.
#AD_CORE_TLS_CERT=/etc/armdash/tls/armdash.crt
#AD_CORE_TLS_KEY=/etc/armdash/tls/armdash.key
#AD_CORE_TLS_ADDR=:443
