[Unit]
Description=armdash home server dashboard
Documentation=https://github.com/xuedi/armdash
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=armdash
Group=armdash
ExecStart=/usr/bin/armdash -env /etc/armdash/armdash.env
Restart=on-failure
RestartSec=5

# Hardening. Every metric lives in Prometheus. The one thing the app writes is
# what people change through a page, the settings, an uploaded floor plan and
# device positions, and that goes to /var/lib/armdash, the only writable path.
# The rest of the filesystem, the env file included, stays read-only.
StateDirectory=armdash
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
UMask=0077
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
# AD_CORE_ADDR may name a port below 1024 (port 80 is the point on a home
# server). The capability makes that possible without running as root.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
