# Committed defaults. The settings page overrides them when there is a data
# directory; .env.local, which is gitignored, and real environment variables
# win over the page.

# Where the server listens. Use :80 for the default HTTP port, the packaged
# systemd unit grants the capability that needs. The -addr flag overrides it.
AD_CORE_ADDR=127.0.0.1:9494

# HTTPS turns on when both paths are set, one without the other refuses to
# start. The address above then redirects here, except /metrics, which
# Prometheus keeps scraping over plain HTTP. Use :443 on a server.
#AD_CORE_TLS_CERT=/etc/armdash/tls/armdash.crt
#AD_CORE_TLS_KEY=/etc/armdash/tls/armdash.key
AD_CORE_TLS_ADDR=127.0.0.1:9495

# Where every metric is read from.
AD_CORE_PROMETHEUS_URL=http://127.0.0.1:9090

# The one login that may change settings, upload a floor plan and place
# devices. With a data directory the settings page asks for it on first start;
# without one, `armdash passwd` prints the pair for .env.local, never here.
#AD_CORE_AUTH_USER=admin
#AD_CORE_AUTH_PASSWORD_HASH=pbkdf2-sha256:600000:...

# Where saved settings, uploaded floor plans and device positions are kept.
# The packaged unit needs nothing here, systemd hands over /var/lib/armdash.
# Unset and outside systemd, nothing can be saved. For development, var is
# gitignored.
#AD_CORE_DATA_DIR=var

# Systems are compiled in; these decide what appears in the navbar.
AD_SYSTEM_HOST_ENABLED=1
AD_SYSTEM_FRITZHOME_ENABLED=1

# Extra navbar entries that show another site below the navbar. List the ids
# in order, then give each a URL. MODE is frame (the default, the browser loads
# the URL in an iframe), proxy (armdash forwards /x/<id>/ to the URL, which
# then only needs to be reachable from here) or tab (opens a new tab). A
# proxied site must generate its links under /x/<id>/, see docs/links.md.
#AD_LINKS=wiki
#AD_LINK_WIKI_TITLE=Wiki
#AD_LINK_WIKI_URL=http://127.0.0.1:8081
#AD_LINK_WIKI_MODE=proxy

# FRITZ!Box. Credentials go in .env.local, never here.
AD_SYSTEM_FRITZHOME_URL=http://fritz.box
AD_SYSTEM_FRITZHOME_USERNAME=
AD_SYSTEM_FRITZHOME_PASSWORD=

# How often the box is polled for the /metrics endpoint Prometheus scrapes.
AD_SYSTEM_FRITZHOME_INTERVAL=60s
